# WebSocket URL of the GPS bridge service (position stream).
# Leave unset for production deploys where the bridge serves this app —
# the display will auto-derive ws[s]://<same-host>/gps from window.location.
# Set explicitly for local dev when running `npm run dev` on a different port:
#   VITE_GPS_WS_URL=ws://localhost:8080/gps
VITE_GPS_WS_URL=

# Same idea for the control channel. Leave empty in production.
#   VITE_CONTROL_WS_URL=ws://localhost:8080/control
VITE_CONTROL_WS_URL=

# MapLibre style URL. Default is dark:
#   - OpenFreeMap "dark-matter" (free, no key) if VITE_MAPBOX_TOKEN below is empty
#   - Mapbox dark-v11 (with the token baked into the URL) if it's set
# Set this to override (e.g., MapTiler streets-v2-dark, Stadia alidade-smooth-dark,
# or a custom Mapbox Studio style URL).
VITE_MAP_STYLE_URL=

# Mapbox access token (used for the Mapbox Directions API and optionally Mapbox styles).
# If unset, ETA and distance show as "—".
VITE_MAPBOX_TOKEN=

# Static destination (will later be replaced by a second WebSocket channel).
VITE_DESTINATION_LAT=25.7907
VITE_DESTINATION_LON=-80.1300
VITE_DESTINATION_LABEL=Destination

# How often to refresh ETA/distance from the Directions API (ms).
VITE_DIRECTIONS_REFRESH_MS=30000

# Allow pan + zoom on the map. Defaults to false (kiosk mode — no input).
# Turn on for dev/demo so you can explore the map manually.
# Rotation stays disabled either way; the map is always north-up.
VITE_MAP_INTERACTIVE=false
