# WebSocket URL of the GPS bridge service
VITE_GPS_WS_URL=ws://localhost:8080

# MapLibre style URL. Defaults to MapLibre's demo style (works without a key).
# For a premium look, use a dark MapTiler or Mapbox style URL:
#   MapTiler: https://api.maptiler.com/maps/streets-v2-dark/style.json?key=YOUR_KEY
#   Mapbox:   mapbox://styles/mapbox/dark-v11 (requires VITE_MAPBOX_TOKEN below)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Mapbox access token (used for the Mapbox Directions API and optionally Mapbox styles).
# If unset, ETA and distance show as "—".
VITE_MAPBOX_TOKEN=

# Static destination (will later be replaced by a second WebSocket channel).
VITE_DESTINATION_LAT=25.7907
VITE_DESTINATION_LON=-80.1300
VITE_DESTINATION_LABEL=Destination

# How often to refresh ETA/distance from the Directions API (ms).
VITE_DIRECTIONS_REFRESH_MS=30000
