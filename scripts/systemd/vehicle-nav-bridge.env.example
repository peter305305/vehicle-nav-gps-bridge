# Installed to /etc/default/vehicle-nav-bridge by install-pi.sh.
# Edit on the Pi and `sudo systemctl restart vehicle-nav-bridge@<user>` to apply.

# Prefer the udev-managed stable symlink — survives unplug/replug regardless of
# which receiver is attached (u-blox, BU-353N, etc).
GPS_SERIAL_PORT=/dev/gps
# Baud rate. Observed defaults:
#   u-blox M10              9600
#   GlobalSat BU-353N       115200  (despite older docs claiming 4800)
#   GlobalSat BU-353 / S4   4800
# If your receiver isn't here, plug it in and run `gps-bridge/probe.js` (left in
# the repo) to scan baud rates and look for legible $GP... sentences.
GPS_BAUD_RATE=115200

# HTTP + WebSocket port. The kiosk Chromium points at http://localhost:$WS_PORT/app/.
WS_PORT=8080

# Where the built display dist lives. Empty disables /app/ serving.
DISPLAY_DIST_DIR=/home/beastpi/vehicle-nav-gps-bridge/display/dist

# Mapbox public token (pk.*) — surfaced to the phone control page so it can
# geocode addresses into destinations. Same value can/should be set as
# VITE_MAPBOX_TOKEN in display/.env so the display uses Mapbox dark + the
# Directions API. Leave empty to disable address geocoding (the phone will
# fall back to a manual lat/lon entry form).
MAPBOX_TOKEN=
