# vehicle-nav bridge environment (macOS).
# install-mac.sh copies this to ~/.config/vehicle-nav/bridge.env if that file
# doesn't exist yet. Edit it there, then apply with:
#   scripts/macos/ctl.sh restart bridge

# Serial device of the GPS receiver. Leave EMPTY to auto-detect — the bridge
# looks for u-blox (vendor 1546) and Prolific PL2303 (vendor 067b) USB devices
# and keeps looking every 5s until one appears, so unplug/replug and sleep/wake
# both recover on their own. Set explicitly only if you have several serial
# devices and auto-detect picks the wrong one:
#   ls /dev/cu.usb*
GPS_SERIAL_PORT=

# Baud rate. Observed defaults:
#   u-blox M8/M9/M10        9600
#   GlobalSat BU-353N       115200  (despite older docs claiming 4800)
#   GlobalSat BU-353 / S4   4800
# Unsure? Run `node gps-bridge/probe.js` with the receiver plugged in.
GPS_BAUD_RATE=9600

# HTTP + WebSocket port. The kiosk Chrome points at http://localhost:$WS_PORT/app/
# and the phone control page is http://<mac-mini>.local:$WS_PORT/
WS_PORT=8080

# Where the built display lives. Leave empty for the default (display/dist next
# to gps-bridge/ in this repo). Set to the literal word "off" to disable /app/.
DISPLAY_DIST_DIR=

# Mapbox public token (pk.*) — surfaced to the phone control page so it can
# geocode addresses into destinations. Put the same value in display/.env as
# VITE_MAPBOX_TOKEN so the display gets ETA/distance from the Directions API.
# Leave empty to disable address geocoding (the phone falls back to a manual
# lat/lon entry form).
MAPBOX_TOKEN=

# Browser for the kiosk. Leave empty to auto-pick Google Chrome, then Chromium.
# Or give a full path to the executable inside the .app bundle.
KIOSK_BROWSER=
